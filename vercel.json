{
  "functions": {
    "api/shirt-print.mjs": { "includeFiles": "shirt-studio/references/graffiti-styleboard.png" }
  },
  "headers": [
    {"source": "/shirt-studio/assets/:file*", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/1993", "headers": [
      {"key": "Cache-Control", "value": "private, no-store"},
      {"key": "X-Robots-Tag", "value": "noindex, nofollow"}
    ]}
  ],
  "redirects": [
    {"source": "/offgrid-demo.html", "destination": "/", "permanent": true},
    {"source": "/shirt-admin", "destination": "/1993?section=shirt", "permanent": false},
    {"source": "/shirt-admin.html", "destination": "/1993?section=shirt", "permanent": false}
  ],
  "rewrites": [
    {"source": "/1993", "destination": "/1993.html"},
    {"source": "/works", "destination": "/works.html"},
    {"source": "/shirt", "destination": "/shirt.html"},
    {"source": "/about", "destination": "/about.html"},
    {"source": "/notes", "destination": "/notes.html"},
    {"source": "/contact", "destination": "/contact.html"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}
